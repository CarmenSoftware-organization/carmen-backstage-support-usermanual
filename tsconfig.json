{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": [
      "node"
    ]
  },
  "include": [
    "packages/**/*.ts",
    "packages/**/*.mts",
    "apps/*/.vitepress/*.mts",
    "apps/*/.vitepress/theme/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "packages/capture/results"
  ]
}
