# Copy to .env (gitignored). Used by the screenshot capture (bun run capture:*).

# Required. Copy the value of REACT_APP_API_APP_ID from carmen-backstage/.env.dev
CAPTURE_APP_ID=

# Optional overrides (defaults target DEV).
# CAPTURE_BASE_URL=https://dev.blueledgers.com:9902
# CAPTURE_API_BASE=https://dev.blueledgers.com:4001

# Optional. Where TEST_USER_EMAIL / TEST_USER_PASSWORD (a DEV Super Admin) come from.
# Default: ../carmen-backstage-e2e/.env
# CAPTURE_ENV_FILE=../carmen-backstage-e2e/.env

# Optional. Set to 1 only for a host with an invalid certificate (DEV's certs are valid).
# CAPTURE_IGNORE_HTTPS_ERRORS=1

# Optional. Gateway rate-limit bypass token; falls back to E2E_RATE_LIMIT_BYPASS_TOKEN
# from the e2e .env. Sent only to the app and API origins. Leave empty to run throttled.
# CAPTURE_RATE_LIMIT_BYPASS_TOKEN=

# Cluster Admin manual (apps/cluster-admin). A DEV cluster admin that is NOT a Super Admin,
# admin of the test cluster below. Without these, the cluster-* capture projects and the
# demo-membership sweep in that cluster are skipped.
CLUSTER_ADMIN_EMAIL=
CLUSTER_ADMIN_PASSWORD=
# Code of the test cluster the shots are taken in (default ZEBRA).
# CLUSTER_ADMIN_CLUSTER_CODE=ZEBRA
