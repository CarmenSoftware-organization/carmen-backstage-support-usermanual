# Copy to .env (gitignored). Used by the screenshot capture (bun run capture:*).

# Required. Copy the value of REACT_APP_API_APP_ID from carmen-platform/.env.dev
CAPTURE_APP_ID=

# Optional overrides (defaults target DEV).
# CAPTURE_BASE_URL=http://dev.blueledgers.com:9902
# CAPTURE_API_BASE=https://dev.blueledgers.com:4001

# Optional. Where TEST_USER_EMAIL / TEST_USER_PASSWORD (a DEV Super Admin) come from.
# Default: ../carmen-platform-e2e/.env
# CAPTURE_ENV_FILE=../carmen-platform-e2e/.env

# Optional. Gateway rate-limit bypass token; falls back to E2E_RATE_LIMIT_BYPASS_TOKEN
# from the e2e .env. Leave empty to run throttled.
# CAPTURE_RATE_LIMIT_BYPASS_TOKEN=
