{
  "name": "carmen-backstage-support-usermanual",
  "private": true,
  "type": "module",
  "workspaces": ["apps/*", "packages/*"],
  "packageManager": "bun@1.4.2",
  "scripts": {
    "build": "turbo run build",
    "dev:support": "turbo run dev --filter=@manual/support",
    "typecheck": "tsc --noEmit",
    "check": "tsc --noEmit && turbo run check",
    "capture:screens": "playwright test -c packages/capture/playwright.config.ts --project=screens-th --project=screens-en",
    "capture:guides": "playwright test -c packages/capture/playwright.config.ts --project=guides-th --project=guides-en",
    "capture": "playwright test -c packages/capture/playwright.config.ts",
    "capture:restore-flags": "bun packages/capture/flags.ts restore",
    "capture:cleanup-demo": "bun packages/capture/demo-data.ts cleanup"
  },
  "devDependencies": {
    "@playwright/test": "^1.58.2",
    "@types/node": "^20",
    "turbo": "^2.11.10",
    "typescript": "^5.9.3",
    "vitepress": "1.6.3"
  }
}
